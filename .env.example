# Compte ANRAN dédié (créé dans l'app officielle, caméra partagée dessus).
# Ne PAS utiliser le compte principal : la session MQTT est unique par compte.
MEARI_EMAIL=
MEARI_PASSWORD=
MEARI_COUNTRY_CODE=FR
MEARI_PHONE_CODE=33
MEARI_PROFILE=anran

# Optionnel : ID de la caméra (sinon détection automatique si une seule caméra)
MEARI_DEVICE_ID=

TZ=Europe/Paris
WEB_PORT=8787
