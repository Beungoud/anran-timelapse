# Compte ANRAN dédié (créé dans l'app officielle, caméra partagée dessus).
# Ne PAS utiliser le compte principal : la session MQTT est unique par compte.
MEARI_EMAIL=
MEARI_PASSWORD=
MEARI_COUNTRY_CODE=FR
MEARI_PHONE_CODE=33
MEARI_PROFILE=anran

# Optionnel : ID de la caméra (sinon détection automatique si une seule caméra)
MEARI_DEVICE_ID=

TZ=Europe/Paris
WEB_PORT=8787

# --- Authentification OpenID Connect (optionnelle mais recommandée) ---------
# Sans OIDC_ISSUER, l'interface est accessible sans connexion.
# URL publique de l'application, telle que tapée dans le navigateur (port inclus).
# L'URL de redirection à déclarer chez le fournisseur est PUBLIC_URL/auth/callback.
PUBLIC_URL=
# Synology SSO Server : URL "Well-known" (SSO Server > Service > OIDC), ex.
# https://nas.exemple.synology.me/webman/sso/.well-known/openid-configuration
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Synology n'accepte que openid, email et groups.
OIDC_SCOPES=openid email groups
# Accès limité à ces utilisateurs / groupes (séparés par des virgules).
# Vides tous les deux = tout compte authentifié par le fournisseur.
OIDC_ALLOWED_USERS=
OIDC_ALLOWED_GROUPS=
# Optionnel : clé de signature des sessions (sinon générée dans data/).
SESSION_SECRET=
